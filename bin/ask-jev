#!/usr/bin/env python3
"""ask-jev — typed decisions from a remote Jev (TypeSafe AI) provider.

  ask-jev route <text>                       task type, needs-web, needs-docs, needs-reasoning
  ask-jev relevant <question> <file>...      relevance score per document (0-1, keep >= 0.5)
  ask-jev triage <file>...                   message type per document
  ask-jev yesno <state> <instruction>        single yes/no score
  ask-jev predict <state> <questions-json>   raw systemone call
  ask-jev status                             resolved provider + model

Provider resolution, first key wins:
  JEV_URL + JEV_API_KEY   any /v1/systemone-compatible endpoint (JEV_MODEL for model id)
  TYPESAFE_API_KEY        api.typesafe.ai            model jev-latest
  OPENCODE_API_KEY        opencode.ai/zen            model JEV_MODEL or jev-1.13-free
  ~/.local/share/opencode/auth.json "opencode-go" key — same Zen endpoint, zero config
  AI_GATEWAY_API_KEY / VERCEL_OIDC_TOKEN   ai-gateway.vercel.sh   model typesafe-ai/jev
  CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN  Workers AI ai.run  model typesafe/jev

Answers go to stdout as JSON; diagnostics to stderr.
"""
import json
import os
import sys
import urllib.error
import urllib.request

AUTH_JSON = os.path.expanduser("~/.local/share/opencode/auth.json")

ROUTE_Q = {
    "task": {
        "type": "choice",
        "instructions": "What kind of request is this?",
        "criteria": {
            "qa": "factual question answered from knowledge or the user's documents",
            "email": "write, reply to, or classify an email or message",
            "summarize": "summarize, reformat, or extract from given text",
            "web_lookup": "needs current information (news, prices, weather, recent events)",
            "chat": "casual conversation",
        },
    },
    "needs_web": {"type": "noul", "instructions": "Does answering require live information the model cannot know (today's news, current prices, weather)?"},
    "needs_docs": {"type": "noul", "instructions": "Would the answer benefit from the user's own documents or emails?"},
    "needs_reasoning": {"type": "noul", "instructions": "Does this require careful multi-step reasoning, math, planning, or weighing options — rather than a direct lookup or short reply?"},
}

TRIAGE_Q = {
    "kind": {
        "type": "choice",
        "instructions": "What kind of message or document is this?",
        "criteria": {
            "invoice_or_billing": "bill, invoice, payment or charge notice",
            "personal": "personal message from a person",
            "booking_or_itinerary": "travel, booking, reservation or schedule",
            "notice": "informational notice, receipt or reminder",
            "work": "work update, standup or team note",
            "other": "none of the above",
        },
    }
}


def _opencode_key():
    try:
        return json.load(open(AUTH_JSON))["opencode-go"]["key"]
    except Exception:
        return None


def provider():
    """Resolve (name, url, key, model, unwrap). First configured wins."""
    if os.environ.get("JEV_URL") and os.environ.get("JEV_API_KEY"):
        return ("custom", os.environ["JEV_URL"].rstrip("/") + "/v1/systemone"
                if not os.environ["JEV_URL"].endswith("/v1/systemone") else os.environ["JEV_URL"],
                os.environ["JEV_API_KEY"], os.environ.get("JEV_MODEL", "jev-latest"), False)
    if os.environ.get("TYPESAFE_API_KEY"):
        return ("typesafe", "https://api.typesafe.ai/v1/systemone",
                os.environ["TYPESAFE_API_KEY"], os.environ.get("JEV_MODEL", "jev-latest"), False)
    key = os.environ.get("OPENCODE_API_KEY") or _opencode_key()
    if key:
        return ("opencode-zen", "https://opencode.ai/zen/v1/systemone",
                key, os.environ.get("JEV_MODEL", "jev-1.13-free"), False)
    key = os.environ.get("AI_GATEWAY_API_KEY") or os.environ.get("VERCEL_OIDC_TOKEN")
    if key:
        return ("vercel-ai-gateway", "https://ai-gateway.vercel.sh/typesafe/v1/systemone",
                key, os.environ.get("JEV_MODEL", "typesafe-ai/jev"), False)
    if os.environ.get("CLOUDFLARE_ACCOUNT_ID") and os.environ.get("CLOUDFLARE_API_TOKEN"):
        return ("cloudflare",
                "https://api.cloudflare.com/client/v4/accounts/%s/ai/run/typesafe/jev"
                % os.environ["CLOUDFLARE_ACCOUNT_ID"],
                os.environ["CLOUDFLARE_API_TOKEN"], None, True)  # cf wraps in {"result": ...}
    sys.exit("ask-jev: no provider configured — set TYPESAFE_API_KEY, OPENCODE_API_KEY, "
             "AI_GATEWAY_API_KEY, or CLOUDFLARE_ACCOUNT_ID+CLOUDFLARE_API_TOKEN")


def predict(state, questions):
    name, url, key, model, unwrap = provider()
    body = {"state": state, "questions": questions}
    if model:
        body["model"] = model
    req = urllib.request.Request(
        url, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + key,
                 # cloudflare 1010 blocks the default urllib UA
                 "User-Agent": "ask-jev/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            res = json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"ask-jev: {name} returned {e.code}: {e.read().decode()[:200]}")
    except Exception as e:
        sys.exit(f"ask-jev: {name} unreachable: {e}")
    return res.get("result", res) if unwrap else res


def answers(result):
    out = {}
    for qid, a in result.get("answers", {}).items():
        for k in ("choice", "score", "noul"):
            if k in a:
                out[qid] = a[k]
                break
        else:
            out[qid] = a
    return out


USAGE = """usage: ask-jev <command> ...
  ask-jev route "text"                        route a user request
  ask-jev relevant "question" FILE...         relevance per file
  ask-jev triage FILE...                      message type per file
  ask-jev yesno "state" "instruction"         yes/no score
  ask-jev predict "state" '<questions-json>'  raw call
  ask-jev status                              provider + model in use"""


def need(args, n):
    if len(args) < n:
        sys.exit(USAGE)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "route":
        need(sys.argv, 3)
        print(json.dumps(answers(predict(sys.argv[2], ROUTE_Q))))
    elif cmd == "relevant":
        need(sys.argv, 4)
        q = sys.argv[2]
        out = []
        for f in sys.argv[3:]:
            text = sys.stdin.read() if f == "-" else open(f).read()
            # filename in state: a doc named flight.txt is itself a signal
            state = f"file: {os.path.basename(f)}\n\n" + text[:4000]
            r = predict(state, {"relevant": {"type": "noul",
                        "instructions": f"Does this text contain information that helps answer: {q}?"}})
            out.append({"file": f, "relevant": answers(r)["relevant"]})
        print(json.dumps(out))
    elif cmd == "triage":
        need(sys.argv, 3)
        out = []
        for f in sys.argv[2:]:
            state = f"file: {os.path.basename(f)}\n\n" + open(f).read()[:4000]
            r = predict(state, TRIAGE_Q)
            out.append({"file": f, "kind": answers(r)["kind"]})
        print(json.dumps(out))
    elif cmd == "yesno":
        need(sys.argv, 4)
        r = predict(sys.argv[2], {"answer": {"type": "noul", "instructions": sys.argv[3]}})
        print(json.dumps(answers(r)))
    elif cmd == "predict":
        need(sys.argv, 4)
        print(json.dumps(predict(sys.argv[2], json.loads(sys.argv[3]))))
    elif cmd == "status":
        name, url, _k, model, _u = provider()
        print(json.dumps({"provider": name, "endpoint": url, "model": model}))
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
